{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/support.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/support",
      "dest": "api/support.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
